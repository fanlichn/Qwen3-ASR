# Generate a private service key with: openssl rand -hex 32
# Required. Never use a cloud provider's key here.
ASR_API_KEY=

# Qwen runs on your GPU. No DeepSeek / OpenAI / DashScope key is needed.
ASR_MODEL_PATH=Qwen/Qwen3-ASR-1.7B
ASR_MODEL_NAME=qwen3-asr-1.7b
ASR_DEVICE=cuda:0

# Host GPU ID exposed to Docker; it appears as cuda:0 inside the container.
ASR_GPU_ID=0
ASR_BIND_HOST=0.0.0.0
ASR_PORT=8080

ASR_MAX_UPLOAD_MB=25
ASR_MAX_AUDIO_SECONDS=1800
ASR_CHUNK_SECONDS=25
ASR_DECODE_TIMEOUT_SECONDS=120

# Optional: Hugging Face token / endpoint when needed for model download.
# HF_TOKEN=
# HF_ENDPOINT=https://huggingface.co
